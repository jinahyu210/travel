{
  "version": 2,
  "regions": ["icn1"],
  "builds": [
    {"src": "api/thumbnail.py", "use": "@vercel/python"},
    {"src": "api/index.py", "use": "@vercel/python"},
    {"src": "static/**", "use": "@vercel/static"}
  ],
  "routes": [
    {"src": "/api/thumbnails/(.*)", "dest": "/api/thumbnail.py?route=$1"},
    {"src": "/api/(.*)", "dest": "/api/index.py?route=$1"},
    {"src": "/", "dest": "/static/index.html"},
    {"src": "/exhibitions/?", "dest": "/static/exhibitions.html"},
    {"src": "/contact/?", "dest": "/static/contact.html"},
    {"src": "/(.*)", "dest": "/static/$1"}
  ]
}
