{
  "version": 2,
  "rewrites": [
    {"source": "/api/:route*", "destination": "/api/index.py?route=:route*"},
    {"source": "/", "destination": "/static/index.html"},
    {"source": "/exhibitions", "destination": "/static/exhibitions.html"},
    {"source": "/exhibitions/", "destination": "/static/exhibitions.html"},
    {"source": "/contact", "destination": "/static/contact.html"},
    {"source": "/contact/", "destination": "/static/contact.html"},
    {"source": "/:asset*", "destination": "/static/:asset*"}
  ]
}
