{
  "version": 2,
  "routes": [
    {"src": "/api/(.*)", "dest": "/api/index.py?route=$1"},
    {"src": "/", "dest": "/static/index.html"},
    {"src": "/exhibitions/?", "dest": "/static/exhibitions.html"},
    {"src": "/contact/?", "dest": "/static/contact.html"},
    {"src": "/(.*)", "dest": "/static/$1"}
  ]
}
